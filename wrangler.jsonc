/**
 * Expliciet's fork of stape-io/google-tag-manager-mcp-server.
 *
 * Diverges from upstream in three places, all of them infrastructure rather
 * than behaviour, so upstream merges stay cheap:
 *   1. "name" is ours, so the Worker deploys to our own workers.dev subdomain.
 *   2. Upstream's "routes" block bound the Worker to gtm-mcp.stape.ai. Removed:
 *      a Workers custom domain requires the zone to live in our Cloudflare
 *      account, and expliciet.be is on Combell's nameservers. See
 *      docs/ARCHITECTURE.md in Expliciet-BV/mcp-google-om.
 *   3. "kv_namespaces.id" is our own namespace, not Stape's.
 *
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gtm-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2025-03-10",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  // Non-secret configuration. GOOGLE_CLIENT_SECRET and COOKIE_ENCRYPTION_KEY
  // are Worker secrets instead, set with `wrangler secret put` and held in
  // 1Password. HOSTED_DOMAIN stays empty on purpose: upstream only sets
  // Google's "hd" hint when it is non-empty, and Expliciet has no Google
  // Workspace organization, so every marketer signs in with a personal account.
  "vars": {
    "WORKER_HOST": "https://gtm-mcp.christophe-vanleeuw.workers.dev",
    "HOSTED_DOMAIN": ""
  },
  "migrations": [
    {
      "new_sqlite_classes": [
        "GoogleTagManagerMCPServer"
      ],
      "tag": "v1"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "GoogleTagManagerMCPServer",
        "name": "MCP_OBJECT"
      }
    ]
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "0a45ab6560e44631ba669e995ff27c18"
    }
  ],
  "observability": {
    "enabled": true
  },
  "dev": {
    "port": 8788
  }
}
